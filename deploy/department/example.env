# Скопіюй у .env у цій самій теці і підстав свої значення:
#   cp example.env .env
#
# Порти на ХОСТІ (Ubuntu сервера кафедри) — зміни, якщо зайняті іншими роботами.
DEPARTMENT_HTTP_PORT=18080
DEPARTMENT_DB_PORT=15432

# Облікові дані PostgreSQL (контейнер; ззовні БД доступна лише якщо відкритий DEPARTMENT_DB_PORT).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=заміни-на-надійний-пароль
POSTGRES_DB=hydroacoustic_expert

# JWT підпис (мінімум ~32 символів; не коміть у git значення з .env).
JWT_KEY=заміни-на-довгий-випадковий-секрет-мінімум-тридцять-два-символи
